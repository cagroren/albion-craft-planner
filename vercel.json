{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/b/:id", "destination": "/api/share?b=:id" },
    { "source": "/g/:id", "destination": "/api/share?g=:id" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    }
  ]
}
